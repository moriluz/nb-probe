{
  "name": "nb-probe",
  "version": "0.2.0",
  "description": "Ownership-gated security probe for apps you run. Supabase first.",
  "license": "MIT",
  "author": "Neural Breach <hello@neural-breach.com>",
  "homepage": "https://neural-breach.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moriluz/nb-probe.git"
  },
  "type": "module",
  "bin": {
    "nb-probe": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "security",
    "supabase",
    "firebase",
    "vibe-coding",
    "idor",
    "bola",
    "scanner"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "tsc -p tsconfig.test.json --noEmit && tsx --test test/unit.test.ts test/discovery.test.ts test/scan.test.ts test/subpath.test.ts test/cli.test.ts",
    "prepublishOnly": "npm run build && npm test",
    "nb-probe": "tsx src/cli.ts",
    "fixture": "tsx test/fixture-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
